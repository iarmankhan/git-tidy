{
  "name": "git-tidy-cli",
  "version": "2.1.0",
  "description": "Interactive CLI tool for cleaning up unused git branches with a beautiful TUI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "git-tidy": "./bin/git-tidy.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "branch",
    "cleanup",
    "cli",
    "tui",
    "github",
    "prune",
    "delete",
    "interactive",
    "terminal"
  ],
  "author": "Arman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArmandBrworworworx/git-tidy.git"
  },
  "bugs": {
    "url": "https://github.com/ArmandBrworworworx/git-tidy/issues"
  },
  "homepage": "https://github.com/ArmandBrworworworx/git-tidy#readme",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@octokit/rest": "^22.0.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "ink": "^7.0.6",
    "react": "^19.2.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=22"
  }
}
